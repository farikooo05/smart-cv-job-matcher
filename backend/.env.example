DATABASE_URL="postgresql://postgres:local_dev_password@localhost:5432/cv_matcher?schema=public"
DIRECT_URL="postgresql://postgres:local_dev_password@localhost:5432/cv_matcher?schema=public"
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"
GOOGLE_CLIENT_ID="your-google-client-id-here"
PORT=5000
FRONTEND_URL="http://localhost:5173"
RESEND_API_KEY="your-resend-api-key-here"

# --- AI service (backend/ai-service) ---
AI_SERVICE_URL="http://127.0.0.1:8000"
# Optional shared secret between the backend and the AI service. Set the same value for both.
AI_SERVICE_KEY=""
GEMINI_API_KEY="your-gemini-api-key-here"

# Models are pinned to exact versions so evaluation results stay reproducible.
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Sampling. Temperature 0 = always take the most likely answer (the task is extraction, not writing).
# GEMINI_TOP_P and GEMINI_TOP_K are optional; leave them unset to use the provider defaults.
GEMINI_TEMPERATURE=0
# GEMINI_TOP_P=0.95
# GEMINI_TOP_K=40

# Retrieval. RETRIEVAL_TOP_K = how many jobs a vector search returns. Two results whose cosine
# similarity to each other is above RETRIEVAL_DUPLICATE_SIMILARITY count as the same vacancy.
RETRIEVAL_TOP_K=10
RETRIEVAL_DUPLICATE_SIMILARITY=0.97
GEMINI_REQUESTS_PER_MINUTE=10

# Job matching (backend): how many retrieved jobs to analyze per user and the cut-offs.
JOB_MATCH_TOP_K=10
JOB_MATCH_MIN_SIMILARITY=0.6
JOB_MATCH_MIN_SCORE=50
JOB_MATCH_TITLE_ONLY_MIN_SIMILARITY=0.68
